# === Wajib ===
# String acak panjang. URL connector: https://<app>.vercel.app/mcp/<MCP_SECRET>
# Buat dengan: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MCP_SECRET=

# OAuth client (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, tipe "Desktop app")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Hasil dari: npm run token
GOOGLE_REFRESH_TOKEN=

# === Opsional ===
# Alamat & nama pengirim di header From (default: diambil dari profil)
SENDER_EMAIL=
SENDER_NAME=

# Profil sebagai JSON (alternatif dari file profile/profile.json, berguna kalau repo publik).
# Boleh JSON mentah atau base64 dari JSON.
PROFILE_JSON=

# Label Gmail yang dipasang ke setiap draft lamaran (dibuat otomatis jika belum ada). Kosongkan untuk mematikan.
DRAFT_LABEL=Lamaran Kerja
